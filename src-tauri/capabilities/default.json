{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Izin eksekusi perintah ADB & Scrcpy",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "run-adb",
          "cmd": "adb",
          "args": true
        },
        {
          "name": "run-powershell",
          "cmd": "powershell",
          "args": true
        },
        {
          "name": "run-pkexec",
          "cmd": "pkexec",
          "args": true
        },
        {
          "name": "run-brew",
          "cmd": "brew",
          "args": true
        },
        {
          "name": "run-scrcpy",
          "cmd": "scrcpy",
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "run-scrcpy",
          "cmd": "scrcpy",
          "args": true
        }
      ]
    }
  ]
}
